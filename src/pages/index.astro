---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'AvoQx Plus — Intelligence beyond the screen';
const description =
  'AvoQx Plus builds production AI and intelligent embedded systems for practical, sustainable impact.';

const capabilities = [
  {
    index: '01',
    title: 'Production ML',
    description:
      'Reproducible model pipelines, evaluation, deployment, and monitoring designed to survive beyond the notebook.',
    signal: 'MODEL → SYSTEM'
  },
  {
    index: '02',
    title: 'Edge intelligence',
    description:
      'Efficient inference, embedded software, electronics, and device integration for intelligence where work happens.',
    signal: 'CLOUD → EDGE'
  },
  {
    index: '03',
    title: 'Sustainable systems',
    description:
      'Technology shaped around measurable value in environmental, agricultural, energy, and infrastructure contexts.',
    signal: 'IDEA → IMPACT'
  }
];

const roadmap = [
  {
    weeks: '01—02',
    title: 'Foundation',
    description: 'Domain framing, safe data architecture, baseline workflows, and measurable success criteria.'
  },
  {
    weeks: '03—04',
    title: 'Intelligence core',
    description: 'Reproducible extraction, classification, verification, and error-analysis experiments.'
  },
  {
    weeks: '05—06',
    title: 'System integration',
    description: 'Backend, interface, model, and hardware boundaries joined into one observable workflow.'
  },
  {
    weeks: '07—08',
    title: 'Validation & demo',
    description: 'End-to-end testing, benchmark publication, public case study, and a responsibly scoped demo.'
  }
];

const metricFrames = [
  ['Macro F1', 'Quality across classes'],
  ['Latency', 'Time to a useful result'],
  ['Reliability', 'Known and tested failure modes'],
  ['Efficiency', 'Compute and device resources']
];
---

<BaseLayout {title} {description}>
  <div id="top" class="site-frame">
    <SiteHeader />

    <main id="main-content">
      <section class="hero section-dark" aria-labelledby="hero-title">
        <div class="hero-noise" aria-hidden="true"></div>
        <div class="page-shell hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow"><span></span> AI × embedded systems × sustainability</p>
            <h1 id="hero-title">
              Intelligence that
              <em>leaves the lab.</em>
            </h1>
            <p class="hero-lede">
              We turn models into dependable systems—and systems into useful,
              responsible outcomes in the physical world.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#verifiai">
                Explore VerifiAI
                <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href="#about">Read our mission <span aria-hidden="true">↓</span></a>
            </div>
          </div>

          <div class="hero-system reveal reveal-delay" aria-label="AvoQx system model">
            <div class="system-orbit orbit-one" aria-hidden="true"></div>
            <div class="system-orbit orbit-two" aria-hidden="true"></div>
            <div class="system-core">
              <span>AVOQX</span>
              <strong>A+</strong>
              <small>system online</small>
            </div>
            <div class="system-node node-model">
              <span>01</span>
              <strong>Model</strong>
            </div>
            <div class="system-node node-data">
              <span>02</span>
              <strong>Data</strong>
            </div>
            <div class="system-node node-device">
              <span>03</span>
              <strong>Device</strong>
            </div>
            <div class="system-node node-impact">
              <span>04</span>
              <strong>Impact</strong>
            </div>
            <p class="system-caption">One continuous engineering loop</p>
          </div>
        </div>

        <div class="page-shell hero-rail" aria-label="Core focus areas">
          <span>Machine learning production</span>
          <span>Edge & embedded intelligence</span>
          <span>Systems for sustainable development</span>
        </div>
      </section>

      <section id="about" class="section section-light about-section" aria-labelledby="about-title">
        <div class="page-shell split-heading reveal">
          <div>
            <p class="section-kicker">Our mission</p>
            <h2 id="about-title">Useful AI is a full-stack engineering problem.</h2>
          </div>
          <div class="large-copy">
            <p>
              AvoQx Plus exists to close the distance between a promising model and a system people can
              trust in the field.
            </p>
            <p>
              We combine machine learning, software, embedded hardware, and domain understanding from the
              beginning—not as separate hand-offs at the end.
            </p>
          </div>
        </div>

        <div class="page-shell principle-grid">
          <article class="principle-card reveal">
            <span class="principle-mark" aria-hidden="true">A</span>
            <h3>Build for evidence</h3>
            <p>Every claim needs a metric, every decision a record, and every result a reproducible path.</p>
          </article>
          <article class="principle-card reveal reveal-delay">
            <span class="principle-mark" aria-hidden="true">V</span>
            <h3>Design for reality</h3>
            <p>Latency, failure modes, compute limits, operators, and environments are product requirements.</p>
          </article>
          <article class="principle-card reveal reveal-delay-two">
            <span class="principle-mark" aria-hidden="true">Q</span>
            <h3>Measure the impact</h3>
            <p>Technology earns its place when it creates a clear, responsible improvement in the real system.</p>
          </article>
        </div>
      </section>

      <section id="capabilities" class="section section-dark capabilities-section" aria-labelledby="capabilities-title">
        <div class="page-shell section-heading reveal">
          <p class="section-kicker section-kicker-dark">What we build</p>
          <h2 id="capabilities-title">From signal to system.</h2>
          <p>Three disciplines, designed as one delivery path.</p>
        </div>

        <div class="page-shell capability-list">
          {capabilities.map((capability) => (
            <article class="capability-row reveal">
              <span class="capability-index">{capability.index}</span>
              <div>
                <h3>{capability.title}</h3>
                <p>{capability.description}</p>
              </div>
              <span class="capability-signal">{capability.signal}</span>
              <span class="capability-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section id="verifiai" class="section project-section" aria-labelledby="verifiai-title">
        <div class="page-shell project-grid">
          <div class="project-intro reveal">
            <p class="section-kicker">Featured project</p>
            <div class="project-status"><span></span> In active development</div>
            <h2 id="verifiai-title">VerifiAI</h2>
            <p class="project-tagline">A traceable intelligence layer for document-heavy audit workflows.</p>
            <p>
              VerifiAI is being designed to help people organize, understand, and verify complex document
              flows—with human review, measurable uncertainty, and privacy boundaries built into the system.
            </p>
            <div class="project-actions">
              <a class="button button-dark" href="#roadmap">View development path</a>
              <span>Case study publishing after validation</span>
            </div>
          </div>

          <div class="flow-card reveal reveal-delay" aria-label="VerifiAI workflow illustration">
            <div class="flow-header">
              <span>VERIFIAI / SYSTEM FLOW</span>
              <span class="live-indicator"><i></i> DESIGNING</span>
            </div>
            <ol class="flow-list">
              <li>
                <span>01</span>
                <div><strong>Ingest</strong><small>Approved references & synthetic samples</small></div>
                <i aria-hidden="true">→</i>
              </li>
              <li>
                <span>02</span>
                <div><strong>Understand</strong><small>Classification & structured extraction</small></div>
                <i aria-hidden="true">→</i>
              </li>
              <li>
                <span>03</span>
                <div><strong>Verify</strong><small>Rules, evidence & confidence signals</small></div>
                <i aria-hidden="true">→</i>
              </li>
              <li>
                <span>04</span>
                <div><strong>Review</strong><small>Human decision with a traceable record</small></div>
                <i aria-hidden="true">✓</i>
              </li>
            </ol>
            <p class="flow-note">No real audit documents are published in this repository or portfolio.</p>
          </div>
        </div>
      </section>

      <section id="team" class="section section-light team-section" aria-labelledby="team-title">
        <div class="page-shell section-heading reveal">
          <p class="section-kicker">The team</p>
          <h2 id="team-title">One system. Two engineering tracks.</h2>
          <p>Seven contributors working through a shared, evidence-first delivery process.</p>
        </div>

        <div class="page-shell team-grid">
          <article class="team-track reveal">
            <div class="track-number">05</div>
            <div>
              <p class="track-label">AI & software</p>
              <h3>From data to dependable product.</h3>
              <ul>
                <li>Machine learning & evaluation</li>
                <li>Data, backend & frontend systems</li>
                <li>Testing, documentation & delivery</li>
              </ul>
            </div>
          </article>
          <article class="team-track team-track-accent reveal reveal-delay">
            <div class="track-number">02</div>
            <div>
              <p class="track-label">Hardware & embedded</p>
              <h3>From software boundary to physical proof.</h3>
              <ul>
                <li>Electronics & board integration</li>
                <li>FPGA, firmware & interfaces</li>
                <li>Measurement, testing & field constraints</li>
              </ul>
            </div>
          </article>
        </div>

        <div class="page-shell approval-note reveal">
          <span class="approval-icon" aria-hidden="true">✓</span>
          <div>
            <strong>Profiles are being prepared with team approval.</strong>
            <p>Names, roles, photographs, and professional links will appear only after each person approves publication.</p>
          </div>
        </div>
      </section>

      <section id="roadmap" class="section section-dark roadmap-section" aria-labelledby="roadmap-title">
        <div class="page-shell roadmap-heading reveal">
          <div>
            <p class="section-kicker section-kicker-dark">Development timeline</p>
            <h2 id="roadmap-title">Eight weeks.<br />One integrated proof.</h2>
          </div>
          <p>
            Milestones move from foundation to a validated demonstration. Public results appear only after
            the relevant evidence is complete and reviewed.
          </p>
        </div>

        <ol class="page-shell roadmap-list">
          {roadmap.map((phase, index) => (
            <li class="roadmap-item reveal">
              <div class="roadmap-progress" aria-hidden="true">
                <span style={`--progress-index: ${index}`}></span>
              </div>
              <span class="roadmap-weeks">WEEKS {phase.weeks}</span>
              <h3>{phase.title}</h3>
              <p>{phase.description}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="results" class="section results-section" aria-labelledby="results-title">
        <div class="page-shell results-grid">
          <div class="results-copy reveal">
            <p class="section-kicker">Public benchmarks</p>
            <h2 id="results-title">Evidence before numbers.</h2>
            <p>
              We will publish benchmark values when the evaluation protocol, dataset version, and error
              analysis have passed team review. Until then, the measurement frame is public—the claims are not.
            </p>
            <span class="pending-badge">Validation pending</span>
          </div>

          <div class="metric-grid">
            {metricFrames.map(([metric, meaning], index) => (
              <article class={`metric-card reveal ${index % 2 ? 'reveal-delay' : ''}`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>—</strong>
                <h3>{metric}</h3>
                <p>{meaning}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="demo" class="section demo-section" aria-labelledby="demo-title">
        <div class="page-shell demo-card reveal">
          <div class="demo-visual" aria-hidden="true">
            <div class="demo-scan"></div>
            <span class="demo-play">▶</span>
            <small>DEMO / PREPARING</small>
          </div>
          <div class="demo-copy">
            <p class="section-kicker section-kicker-dark">Product demonstration</p>
            <h2 id="demo-title">Show the whole system—not a perfect screenshot.</h2>
            <p>
              The public demo will show the input boundary, model signal, verification path, human review,
              and known limitations together.
            </p>
            <span>Publishing after end-to-end validation</span>
          </div>
        </div>
      </section>

      <section id="contact" class="section contact-section" aria-labelledby="contact-title">
        <div class="page-shell contact-grid">
          <div class="reveal">
            <p class="section-kicker">Contact</p>
            <h2 id="contact-title">Build something that survives contact with reality.</h2>
          </div>
          <div class="contact-card reveal reveal-delay">
            <p>
              We are preparing our public contact channels. For now, follow the organization and watch the
              portfolio take shape on GitHub.
            </p>
            <a class="button button-primary" href="https://github.com/AvoQx-Plus" rel="noreferrer">
              Visit AvoQx Plus on GitHub <span aria-hidden="true">↗</span>
            </a>
            <small>Public email and social profiles pending approval.</small>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <script>
    const header = document.querySelector('[data-site-header]');
    const toggle = document.querySelector('[data-nav-toggle]');
    const nav = document.querySelector('[data-site-nav]');

    const closeNavigation = () => {
      if (!(toggle instanceof HTMLButtonElement) || !(header instanceof HTMLElement)) return;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation');
      header.removeAttribute('data-nav-open');
    };

    if (toggle instanceof HTMLButtonElement && header instanceof HTMLElement) {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
        header.toggleAttribute('data-nav-open', !isOpen);
      });
    }

    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header instanceof HTMLElement && header.hasAttribute('data-nav-open')) {
        closeNavigation();
        if (toggle instanceof HTMLButtonElement) toggle.focus();
      }
    });

    window.addEventListener(
      'scroll',
      () => header?.toggleAttribute('data-scrolled', window.scrollY > 20),
      { passive: true }
    );

    const revealElements = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      try {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -48px' }
        );
        document.documentElement.classList.add('reveal-ready');
        revealElements.forEach((element) => observer.observe(element));
      } catch {
        document.documentElement.classList.remove('reveal-ready');
      }
    } else {
      revealElements.forEach((element) => element.classList.add('is-visible'));
    }
  </script>
</BaseLayout>
